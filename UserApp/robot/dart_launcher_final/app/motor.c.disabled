    [LAUNCH_M_SPRING_B] =
        {
            .tx_id = LAUNCH_SB_ID,
            .ratio = LAUNCH_SB_RATIO,
            .reverse = LAUNCH_SB_REVERSE,
            .deg_zero = LAUNCH_SB_DEG_ZERO,
            .deg_prep = LAUNCH_SB_DEG_PREP,
            .tol_deg = LAUNCH_SB_TOL_DEG,
            .angle_kp = LAUNCH_SB_ANGLE_KP,
